/* @import url('https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

/* ── Google Fonts ───────────────────────────────────── */

:root {
  /* Premium Islamic Palette - Deep Emerald & Antique Gold */
  --islamic-deep: #011816;
  --islamic-primary: #012B25;
  --islamic-glow: rgba(1, 43, 37, 0.8);
  
  --gold-primary: #D4AF37;
  --gold-light: #F9D71C;
  --gold-glow: rgba(212, 175, 55, 0.4);
  --gold-border: rgba(212, 175, 55, 0.6);
  
  --glass-bg: rgba(1, 24, 22, 0.75);
  --glass-border: rgba(212, 175, 55, 0.3);
}

/* ── Global Styles ────────────────────────────────────── */
body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background: radial-gradient(circle at center, var(--islamic-primary) 0%, var(--islamic-deep) 100%);
  color: #F3F1E8;
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
}

/* ── Premium Islamic Background Pattern ──────────────── */
body::before {
  content: "";
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.05;
  background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M30 0l2.5 7.5L40 10l-7.5 2.5L30 20l-2.5-7.5L20 10l7.5-2.5L30 0zm0 40l2.5 7.5L40 50l-7.5 2.5L30 60l-2.5-7.5L20 50l7.5-2.5L30 40zM0 30l7.5 2.5L10 40l2.5-7.5L20 30l-7.5-2.5L10 20l-2.5 7.5L0 30zm40 0l7.5 2.5L50 40l2.5-7.5L60 30l-7.5-2.5L50 20l-2.5 7.5L40 30z' fill='%23D4AF37' fill-rule='evenodd'/%3E%3C/svg%3E");
  pointer-events: none;
  z-index: 0;
}

/* ── Decorative Lanterns ────────────────────────────── */
.lantern-decoration {
  position: fixed;
  top: -20px;
  width: 80px;
  height: 150px;
  background: linear-gradient(to bottom, transparent, var(--gold-glow));
  mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 100 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M50 0v20M20 20h60l10 40-20 100-25 20-25-20-20-100 10-40z' fill='black'/%3E%3C/svg%3E");
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 100 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M50 0v20M20 20h60l10 40-20 100-25 20-25-20-20-100 10-40z' fill='black'/%3E%3C/svg%3E");
  mask-size: contain;
  mask-repeat: no-repeat;
  z-index: 10;
  opacity: 0.6;
}

.lantern-left { left: 5%; animation: swing 6s infinite ease-in-out; }
.lantern-right { right: 5%; animation: swing 7s infinite ease-in-out; animation-delay: 1s; }

@keyframes swing {
  0%, 100% { transform: rotate(-3deg); transform-origin: top center; }
  50% { transform: rotate(3deg); transform-origin: top center; }
}

/* ── Premium Glassmorphism ────────────────────────── */
.glass-panel {
  background: var(--glass-bg);
  backdrop-filter: blur(20px) saturate(160%);
  -webkit-backdrop-filter: blur(20px) saturate(160%);
  border: 1px solid var(--glass-border);
  box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.4);
}

.ultimate-container {
  border: 2px solid var(--gold-border);
  box-shadow: 
    0 25px 50px -12px rgba(0, 0, 0, 0.6),
    0 0 20px rgba(212, 175, 55, 0.2);
  background: linear-gradient(135deg, rgba(1, 31, 27, 0.9) 0%, rgba(1, 43, 37, 0.95) 100%);
}

/* ── Typography ─────────────────────────────────────── */
.font-amiri { font-family: 'Amiri', serif; }
.font-inter { font-family: 'Inter', sans-serif; }
.font-outfit { font-family: 'Outfit', sans-serif; }

.gold-gradient-text {
  background: linear-gradient(135deg, var(--gold-primary) 0%, var(--gold-light) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* ── Animations ─────────────────────────────────────── */
.hover-gold-glow:hover {
  box-shadow: 0 0 15px var(--gold-glow);
  border-color: var(--gold-primary);
  transition: all 0.3s ease;
}

.arabic-verse {
  font-family: 'Amiri', serif;
  font-size: 1.5rem;
  line-height: 2.5rem;
  direction: rtl;
  text-align: center;
  margin: 1.5rem 0;
  color: var(--gold-text);
}

/* ── Museum Plaque Aesthetic ────────────────────────── */
.museum-plaque {
  font-family: 'Inter', sans-serif;
  position: relative;
  background: linear-gradient(165deg, 
    rgba(1, 43, 37, 0.85) 0%, 
    rgba(1, 31, 27, 0.95) 100%
  );
  border: 1px solid rgba(212, 175, 55, 0.4);
  box-shadow: 
    inset 0 0 40px rgba(0, 0, 0, 0.6),
    0 20px 50px rgba(0, 0, 0, 0.8),
    0 0 15px rgba(212, 175, 55, 0.1);
  backdrop-filter: blur(25px) saturate(200%);
  color: #F3F1E8;
  border-radius: 2.5rem;
  padding: 2.5rem;
}

.museum-plaque::before {
  content: "";
  position: absolute;
  top: 10px;
  left: 10px;
  right: 10px;
  bottom: 10px;
  border: 1px solid rgba(212, 175, 55, 0.2);
  border-radius: inherit;
  pointer-events: none;
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.03) 0%, transparent 100%);
}

.museum-plaque::after {
  content: "✨";
  position: absolute;
  top: 1.5rem;
  right: 1.5rem;
  font-size: 10px;
  opacity: 0.3;
  color: var(--gold-primary);
}

.scholarly-layout {
  display: flex;
  height: clamp(650px, 85vh, 1050px);
  width: 95vw;
  max-width: 1400px;
  margin: 0 auto;
  gap: 0;
  border: 2px solid var(--gold-border);
  border-radius: 3.5rem;
  overflow: hidden;
  box-shadow: 
    0 50px 100px rgba(0,0,0,0.9),
    inset 0 0 40px rgba(1, 43, 37, 0.4);
  position: relative;
  z-index: 50;
  background: rgba(1, 24, 22, 0.6);
  backdrop-filter: blur(30px) saturate(180%);
}

.scholarly-sidebar {
  width: 380px;
  flex-shrink: 0;
  background: rgba(1, 31, 27, 0.6);
  backdrop-filter: blur(50px);
  border-right: 1px solid var(--glass-border);
  display: flex;
  flex-direction: column;
  padding: 3rem 2rem;
  overflow-y: auto;
}

.insight-card {
  padding: 1.5rem;
  border-radius: 1.5rem;
  background: rgba(1, 43, 37, 0.3);
  border: 1px solid rgba(212, 175, 55, 0.15);
  margin-bottom: 1.25rem;
  transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.insight-card:hover {
  background: rgba(212, 175, 55, 0.05);
  border-color: var(--gold-primary);
  transform: translateX(8px);
  box-shadow: 0 15px 40px rgba(0,0,0,0.4);
}

.insight-card.active {
  background: rgba(212, 175, 55, 0.08);
  border: 2px solid var(--gold-primary);
  box-shadow: inset 0 0 20px rgba(212, 175, 55, 0.05);
}

.header-calligraphy {
  font-family: 'Amiri', serif;
  font-size: 1.5rem;
  opacity: 0.9;
  text-align: right;
  line-height: normal;
  background: linear-gradient(135deg, #FFF 0%, #D4AF37 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.footer-calligraphy {
  font-family: 'Amiri', serif;
  font-size: 3.5rem;
  opacity: 0.7;
  text-align: center;
  margin-top: 4rem;
  letter-spacing: 0.1em;
}

.plaque-header {
  border-bottom: 1px solid var(--glass-border);
  background: rgba(255, 255, 255, 0.02);
  padding: 1.5rem 3rem;
  flex-shrink: 0;
}

.plaque-chat-area {
  flex: 1;
  background: rgba(1, 31, 27, 0.2);
  display: flex;
  flex-direction: column;
  position: relative;
}

/* Custom Scrollbar for the Plaque */
.no-scrollbar::-webkit-scrollbar {
  display: none;
}
.no-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}
